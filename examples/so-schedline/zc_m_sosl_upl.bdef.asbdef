projection;
strict ( 2 );
use draft;

define behavior for ZC_M_SOSL_UPL alias Root
{
  //  use create;   // Root is created only via uploadExcel
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action uploadExcel;
  use action downloadFile;

  use association _Data { create; with draft; }

}

define behavior for ZC_D_SOSL_UPL alias Data
{
  use update;
  use delete;
  use action PostConfirm;
  use association _File { with draft; }
}
